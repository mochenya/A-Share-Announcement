# CNInfo HTTP timeout defaults, in seconds.
# CNINFO_TIMEOUT is the fallback for connect/read/write/pool when a specific value is unset.
CNINFO_TIMEOUT=10
CNINFO_CONNECT_TIMEOUT=10
CNINFO_READ_TIMEOUT=10
CNINFO_WRITE_TIMEOUT=10
CNINFO_POOL_TIMEOUT=10

# CNInfo connection pool and retry settings.
CNINFO_MAX_CONNECTIONS=100
CNINFO_MAX_KEEPALIVE_CONNECTIONS=20
CNINFO_KEEPALIVE_EXPIRY=5
CNINFO_RETRIES=2

# Optional CNInfo browser User-Agent override.
# Leave unset to use the package default; client(user_agent=...) takes precedence.
CNINFO_USER_AGENT=

# SSE HTTP timeout defaults, in seconds.
# SSE_TIMEOUT is the fallback for connect/read/write/pool when a specific value is unset.
# SSE keyword-only searches may span multiple windows, so read timeout is slightly longer.
SSE_TIMEOUT=
SSE_CONNECT_TIMEOUT=10
SSE_READ_TIMEOUT=30
SSE_WRITE_TIMEOUT=10
SSE_POOL_TIMEOUT=10

# SSE connection pool and retry settings.
SSE_MAX_CONNECTIONS=10
SSE_MAX_KEEPALIVE_CONNECTIONS=5
SSE_KEEPALIVE_EXPIRY=30
SSE_RETRIES=2

# Optional SSE browser User-Agent override.
# Leave unset to use the package default; client(user_agent=...) takes precedence.
SSE_USER_AGENT=
